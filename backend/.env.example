# Backend configuration. Copy to .env and fill in your values.
# .env is gitignored — never commit real keys.

# --- AI (required for chat / embeddings / RAG) --------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Leave blank to run degraded: the app still starts, every non-AI endpoint
# works, and AI calls return 503 with an explanatory message.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
LLM_TEMPERATURE=0.7

# --- Storage -----------------------------------------------------------------
# Everything stateful lives under here: SQLite, ChromaDB, uploads, logs.
# Local default is backend/data. In Docker/Render this is a mounted volume.
DATA_DIR=./data

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# true enables auto-reload and seeds the admin/admin123 demo account.
DEBUG=true
LOG_LEVEL=INFO

# --- CORS --------------------------------------------------------------------
# Comma-separated exact origins. A wildcard cannot be used with credentials,
# so list the real frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security ----------------------------------------------------------------
# JWT signing key. Startup REFUSES to run with DEBUG=false while this is the
# shipped default. Generate one with: openssl rand -hex 32
SECRET_KEY=nexus-ai-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- RAG ---------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=3

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_SIZE=52428800
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# --- Feature flags -----------------------------------------------------------
# WARNING: ENABLE_TERMINAL_TOOL runs shell commands on the server. Keep it
# false on anything publicly reachable.
ENABLE_TERMINAL_TOOL=false

# Requires `playwright install chromium` in the runtime image.
ENABLE_BROWSER_TOOL=false
